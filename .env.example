# --- Nom de l'app ---
NEXT_PUBLIC_APP_NAME="Jump Seat"

# --- URL publique du site déployé (utilisée dans les liens des e-mails) ---
NEXT_PUBLIC_SITE_URL=https://jump-seat.vercel.app

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Mêmes projet/clé anon, mais accessibles côté navigateur (auth par e-mail) :
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Clé RapidAPI pour AeroDataBox (aerodatabox.com) ---
# Un plan gratuit existe sur RapidAPI / API.market pour démarrer.
AERODATABOX_RAPIDAPI_KEY=your-rapidapi-key

# --- Resend (resend.com), pour l'e-mail de rappel de résultat ---
# Distinct des e-mails d'auth, gérés nativement par Supabase Auth.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="Jump Seat <onboarding@resend.dev>"

# --- Secret partagé pour protéger la route de cron /api/remind ---
# Génère-en un avec : openssl rand -hex 32
CRON_SECRET=change-me
